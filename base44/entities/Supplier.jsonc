{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Kode supplier, unik"
    },
    "name": {
      "type": "string",
      "description": "Nama supplier"
    },
    "contact_person": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "name"
  ]
}