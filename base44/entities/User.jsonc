{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "user_code": {
      "type": "string",
      "description": "Kode pengguna (auto: USR-00001)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Status akses pengguna"
    },
    "permissions": {
      "type": "object",
      "description": "Matriks hak akses per menu/aksi"
    }
  }
}