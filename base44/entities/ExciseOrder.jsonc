{
  "name": "ExciseOrder",
  "type": "object",
  "properties": {
    "excise_number": {
      "type": "string",
      "description": "Nomor proses cukai, unik"
    },
    "brand_id": {
      "type": "string"
    },
    "brand_name": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "batch_number": {
      "type": "string"
    },
    "bottle_size": {
      "type": "number"
    },
    "quantity": {
      "type": "integer",
      "description": "Jumlah barang"
    },
    "excise_label_type": {
      "type": "string",
      "description": "Jenis pita cukai"
    },
    "document_number": {
      "type": "string",
      "description": "Nomor dokumen"
    },
    "excise_reference_number": {
      "type": "string",
      "description": "Nomor referensi cukai"
    },
    "excise_date": {
      "type": "string",
      "format": "date"
    },
    "operator": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "diproses",
        "selesai",
        "siap_jual",
        "dibatalkan"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "excise_date",
    "quantity",
    "status"
  ]
}