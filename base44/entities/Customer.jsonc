{
  "name": "Customer",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Kode customer (auto-generate: CUS-YYYY-00001), unik"
    },
    "name": {
      "type": "string",
      "description": "Nama customer"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "sales_person": {
      "type": "string"
    },
    "credit_limit": {
      "type": "number",
      "default": 0,
      "description": "Limit piutang"
    },
    "default_payment_terms": {
      "type": "integer",
      "default": 0,
      "description": "Termin pembayaran default (hari)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}