{
  "name": "Sale",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Nomor invoice (auto: INV-YYYYMM-00001), unik"
    },
    "transaction_date": {
      "type": "string",
      "format": "date"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "sales_person": {
      "type": "string"
    },
    "warehouse_id": {
      "type": "string"
    },
    "warehouse_name": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "transfer",
        "tempo"
      ],
      "default": "cash"
    },
    "payment_terms": {
      "type": "integer",
      "default": 0,
      "description": "Termin pembayaran (hari)"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "tax": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "total_payment": {
      "type": "number",
      "default": 0
    },
    "remaining_receivable": {
      "type": "number",
      "default": 0
    },
    "transaction_status": {
      "type": "string",
      "enum": [
        "draft",
        "posted",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "belum_dibayar",
        "sebagian_dibayar",
        "lunas",
        "jatuh_tempo"
      ],
      "default": "belum_dibayar"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "transaction_date",
    "customer_id",
    "payment_method",
    "transaction_status"
  ]
}