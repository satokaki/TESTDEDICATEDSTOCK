{
  "name": "LabelingOrder",
  "type": "object",
  "properties": {
    "labeling_number": {
      "type": "string",
      "description": "Nomor labeling, unik"
    },
    "brand_id": {
      "type": "string"
    },
    "brand_name": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "batch_id": {
      "type": "string"
    },
    "batch_number": {
      "type": "string"
    },
    "bottle_size": {
      "type": "number"
    },
    "quantity": {
      "type": "integer",
      "description": "Jumlah barang dilabeli"
    },
    "label_type": {
      "type": "string",
      "description": "Jenis label"
    },
    "operator": {
      "type": "string"
    },
    "labeling_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "diproses",
        "selesai",
        "belum_cukai",
        "dibatalkan"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "labeling_date",
    "quantity",
    "status"
  ]
}