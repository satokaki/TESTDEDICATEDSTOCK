{
  "name": "Material",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Kode bahan, unik"
    },
    "name": {
      "type": "string",
      "description": "Nama bahan"
    },
    "category_id": {
      "type": "string",
      "description": "ID kategori bahan"
    },
    "category_name": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID supplier utama"
    },
    "supplier_name": {
      "type": "string"
    },
    "material_type": {
      "type": "string",
      "enum": [
        "RAW_MATERIAL",
        "PREMIX",
        "PACKAGING",
        "LABEL",
        "STICKER",
        "BOTTLE",
        "CONSUMABLE",
        "FINISHED_GOOD"
      ],
      "default": "RAW_MATERIAL",
      "description": "Klasifikasi bahan: RAW_MATERIAL (bahan baku), PREMIX (setengah jadi internal), PACKAGING (kemasan umum), LABEL (label), STICKER (stiker), BOTTLE (botol), FINISHED_GOOD (barang jadi)"
    },
    "is_internally_produced": {
      "type": "boolean",
      "default": false,
      "description": "Diproduksi internal (true untuk PREMIX)"
    },
    "is_recipe_ingredient": {
      "type": "boolean",
      "default": true,
      "description": "Boleh dipilih sebagai ingredient resep."
    },
    "concentration_value": {
      "type": "number",
      "description": "Nilai konsentrasi (mis. 10 untuk 10%)"
    },
    "concentration_unit": {
      "type": "string",
      "enum": [
        "PERCENT_WW",
        "PERCENT_WV",
        "PERCENT_VV"
      ],
      "description": "Satuan konsentrasi premix"
    },
    "carrier_material_id": {
      "type": "string",
      "description": "ID bahan carrier (mis. PG)"
    },
    "carrier_material_name": {
      "type": "string"
    },
    "default_density": {
      "type": "number",
      "description": "Density default (gram/ml) hasil premix"
    },
    "material_category": {
      "type": "string",
      "enum": [
        "flavor",
        "propylene_glycol",
        "vegetable_glycerin",
        "nicotine",
        "sweetener",
        "cooling",
        "additive",
        "premix",
        "lainnya"
      ],
      "description": "Jenis bahan fungsional"
    },
    "unit": {
      "type": "string",
      "enum": [
        "gram",
        "mililiter",
        "unit"
      ],
      "default": "gram"
    },
    "density": {
      "type": "number",
      "description": "Density gram per ml"
    },
    "pg_content": {
      "type": "number",
      "description": "Kandungan PG (%)"
    },
    "vg_content": {
      "type": "number",
      "description": "Kandungan VG (%)"
    },
    "nicotine_strength": {
      "type": "number",
      "description": "Kekuatan nicotine (mg/ml) jika bahan nicotine base"
    },
    "min_stock": {
      "type": "number",
      "default": 0
    },
    "last_purchase_price": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "bottle_size_ml": {
      "type": "number",
      "description": "Ukuran botol/label (ml) untuk pencocokan otomatis saat bottling/labeling. Wajib untuk BOTTLE; opsional untuk LABEL/STICKER (universal boleh kosong)."
    },
    "color": {
      "type": "string",
      "description": "Warna (botol/label), mis. Transparan, Hitam, Putih"
    },
    "model": {
      "type": "string",
      "description": "Model/bentuk botol, mis. Chubby Gorilla, Unicorn"
    },
    "cap_type": {
      "type": "string",
      "description": "Jenis tutup jika satu paket dengan botol"
    },
    "material_spec": {
      "type": "string",
      "description": "Material (PET, PE, kertas, vinyl, dll)"
    },
    "brand_id": {
      "type": "string",
      "description": "Merk terkait (untuk label/botol khusus merk). Kosong = universal."
    },
    "product_id": {
      "type": "string",
      "description": "Produk terkait (untuk label/botol khusus produk). Kosong = universal."
    },
    "label_type": {
      "type": "string",
      "description": "Jenis label: depan, belakang, batch, universal"
    }
  },
  "required": [
    "code",
    "name",
    "unit"
  ]
}