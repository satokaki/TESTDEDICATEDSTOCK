{
  "name": "ProductionOrder",
  "type": "object",
  "properties": {
    "production_number": {
      "type": "string",
      "description": "Nomor produksi (auto: PRD-YYYYMM-00001), unik"
    },
    "batch_number": {
      "type": "string",
      "description": "Nomor batch (auto: BATCH-MMM-YYYYMMDD-001), unik"
    },
    "production_type": {
      "type": "string",
      "enum": [
        "PREMIX",
        "FINISHED_PRODUCT"
      ],
      "default": "FINISHED_PRODUCT",
      "description": "Mode produksi: PREMIX atau FINISHED_PRODUCT"
    },
    "production_date": {
      "type": "string",
      "format": "date"
    },
    "recipe_id": {
      "type": "string"
    },
    "recipe_code": {
      "type": "string"
    },
    "recipe_version": {
      "type": "integer"
    },
    "recipe_type": {
      "type": "string",
      "enum": [
        "PREMIX",
        "FINISHED_PRODUCT"
      ],
      "description": "Snapshot tipe resep"
    },
    "calculation_basis": {
      "type": "string",
      "enum": [
        "W_W",
        "W_V",
        "V_V"
      ],
      "description": "Basis perhitungan (premix)"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "brand_name": {
      "type": "string"
    },
    "output_material_id": {
      "type": "string",
      "description": "Bahan premix output (premix production)"
    },
    "output_material_name": {
      "type": "string"
    },
    "output_batch_id": {
      "type": "string",
      "description": "ID PremixBatch hasil"
    },
    "output_batch_code": {
      "type": "string"
    },
    "target_volume": {
      "type": "number",
      "description": "Target volume (ml) \u2014 finished product"
    },
    "target_quantity": {
      "type": "number",
      "description": "Target quantity premix (gram/ml)"
    },
    "target_unit": {
      "type": "string",
      "enum": [
        "gram",
        "mililiter"
      ]
    },
    "actual_output_quantity": {
      "type": "number",
      "description": "Output aktual premix"
    },
    "waste_quantity": {
      "type": "number",
      "description": "Selisih/waste premix"
    },
    "waste_unit": {
      "type": "string"
    },
    "actual_volume": {
      "type": "number",
      "description": "Volume aktual (ml)"
    },
    "operator": {
      "type": "string"
    },
    "approver": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "menunggu_bahan",
        "siap_produksi",
        "sedang_diproses",
        "selesai_mixing",
        "siap_bottling",
        "dibatalkan"
      ],
      "default": "draft"
    },
    "recipe_snapshot": {
      "type": "string",
      "description": "JSON snapshot resep saat produksi"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "production_date",
    "status"
  ]
}