{
  "name": "CustomerPayment",
  "type": "object",
  "properties": {
    "payment_number": {
      "type": "string",
      "description": "Nomor pembayaran (auto: PAY-YYYYMM-00001), unik"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "total_payment": {
      "type": "number",
      "description": "Total pembayaran"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "transfer"
      ],
      "default": "cash"
    },
    "cash_account": {
      "type": "string",
      "description": "Kas atau rekening tujuan"
    },
    "reference_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "payment_date",
    "customer_id",
    "total_payment",
    "payment_method"
  ]
}