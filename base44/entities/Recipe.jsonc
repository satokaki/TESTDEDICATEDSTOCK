{
  "name": "Recipe",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Kode resep, unik"
    },
    "name": {
      "type": "string",
      "description": "Nama resep"
    },
    "recipe_type": {
      "type": "string",
      "enum": [
        "PREMIX",
        "FINISHED_PRODUCT"
      ],
      "default": "FINISHED_PRODUCT",
      "description": "PREMIX menghasilkan bahan baru; FINISHED_PRODUCT menghasilkan produk akhir"
    },
    "output_material_id": {
      "type": "string",
      "description": "Bahan premix yang dihasilkan (wajib untuk recipe_type=PREMIX)"
    },
    "output_material_name": {
      "type": "string"
    },
    "calculation_basis": {
      "type": "string",
      "enum": [
        "W_W",
        "W_V",
        "V_V"
      ],
      "default": "W_W",
      "description": "Basis perhitungan: W_W (gram/total gram), W_V (gram/total volume), V_V (ml/total ml)"
    },
    "brand_id": {
      "type": "string"
    },
    "brand_name": {
      "type": "string"
    },
    "product_id": {
      "type": "string",
      "description": "Produk terkait (untuk FINISHED_PRODUCT)"
    },
    "product_name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "default": 1,
      "description": "Versi resep"
    },
    "parent_recipe_id": {
      "type": "string",
      "description": "ID resep induk untuk versi baru"
    },
    "target_volume": {
      "type": "number",
      "description": "Target volume standar (ml)"
    },
    "target_quantity": {
      "type": "number",
      "description": "Target quantity premix (gram/ml) untuk PREMIX"
    },
    "target_unit": {
      "type": "string",
      "enum": [
        "gram",
        "mililiter"
      ]
    },
    "target_nicotine": {
      "type": "number",
      "description": "Target nicotine (mg/ml)"
    },
    "target_pg": {
      "type": "number",
      "description": "Target PG (%)"
    },
    "target_vg": {
      "type": "number",
      "description": "Target VG (%)"
    },
    "total_flavor": {
      "type": "number",
      "description": "Total flavor (%)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "inactive"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "code",
    "name",
    "status"
  ]
}