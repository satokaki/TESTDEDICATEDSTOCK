{
  "name": "Recipe",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Kode resep, unik"
    },
    "name": {
      "type": "string",
      "description": "Nama resep"
    },
    "brand_id": {
      "type": "string"
    },
    "brand_name": {
      "type": "string"
    },
    "product_id": {
      "type": "string",
      "description": "Produk terkait"
    },
    "product_name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "default": 1,
      "description": "Versi resep"
    },
    "parent_recipe_id": {
      "type": "string",
      "description": "ID resep induk untuk versi baru"
    },
    "target_volume": {
      "type": "number",
      "description": "Target volume standar (ml)"
    },
    "target_nicotine": {
      "type": "number",
      "description": "Target nicotine (mg/ml)"
    },
    "target_pg": {
      "type": "number",
      "description": "Target PG (%)"
    },
    "target_vg": {
      "type": "number",
      "description": "Target VG (%)"
    },
    "total_flavor": {
      "type": "number",
      "description": "Total flavor (%)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "inactive"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "code",
    "name",
    "status"
  ]
}